# ====================== Wrapper Service ======================
ENV=prod
WRAPPER_SECRET=change-me

# Docling connection
DOCLING_URL=http://docling:5001
DOCLING_API_KEY=
DOCLING_TIMEOUT=600

# Chunking
CHUNK_TARGET=1000
CHUNK_MAX=1000
CHUNK_OVERLAP=200

# ====================== Docling Serve ======================
DOCLING_SERVE_ENABLE_UI=false
DOCLING_SERVE_ENABLE_REMOTE_SERVICES=true
DOCLING_SERVE_MAX_SYNC_WAIT=600
DOCLING_SERVE_LOAD_MODELS_AT_BOOT=true
DOCLING_SERVE_ARTIFACTS_PATH=/opt/app-root/src/.cache/docling/models
DOCLING_SERVE_OPTIONS_CACHE_SIZE=2
DOCLING_SERVE_SCRATCH_PATH=/scratch
DOCLING_DEVICE=auto

# Docling workers
DOCLING_SERVE_ENG_LOC_NUM_WORKERS=2
DOCLING_SERVE_ENG_LOC_SHARE_MODELS=true
UVICORN_WORKERS=1

# Docling memory tuning
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
MALLOC_ARENA_MAX=2
PYTHONMALLOC=malloc
USE_NNPACK=0
